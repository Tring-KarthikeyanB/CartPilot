# Copy to backend/.env and fill in. Never commit .env.
# In production (Render) set these as environment variables in the dashboard instead.

ENVIRONMENT=development

# --- AI (Google Gemini) ---
# Get a key at https://aistudio.google.com/app/apikey
# The free tier allows ~20 requests/day per model; enable billing for demos.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Tried in order when the primary model is rate limited or out of quota
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
AI_TIMEOUT_SECONDS=60

# --- PayPal Sandbox (https://developer.paypal.com/dashboard/applications/sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Public HTTPS URL of this backend, used for PayPal return/cancel URLs.
# Leave empty locally (the URL the app called is used, e.g. http://10.0.2.2:8000).
# On Render it is detected automatically from RENDER_EXTERNAL_URL.
PUBLIC_BASE_URL=

# Deep link the backend hands off to after PayPal approval/cancel
ANDROID_DEEP_LINK=cartpilot://payment
