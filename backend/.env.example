# Copy to backend/.env and fill in. Never commit .env.

ENVIRONMENT=development

# --- AI (Google Gemini) ---
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- PayPal Sandbox (https://developer.paypal.com/dashboard/applications/sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Public HTTPS URL of this backend (Render URL in production). Used to build
# PayPal return/cancel URLs, e.g. https://cartpilot-api.onrender.com
PUBLIC_BASE_URL=http://localhost:8000

# Deep link the backend redirects to after PayPal approval/cancel
ANDROID_DEEP_LINK=cartpilot://payment
